# URL base dell'host Ollama locale
OLLAMA_BASE_URL=http://localhost:11434

# Modello predefinito da utilizzare
DEFAULT_MODEL=llama3:latest

# Ambiente dell'applicazione (development, production)
APP_ENV=development

# Configurazione TTS locale
# Provider disponibili: piper (attivo), cloud (predisposto)
TTS_PROVIDER=piper
# Voce predefinita (es: it_IT-riccardo-x_low, en_US-lessac-medium)
TTS_DEFAULT_VOICE=it_IT-paola-medium
# Velocità predefinita (1.0 = normale)
TTS_DEFAULT_SPEED=1.0
# Lingua predefinita (it = Italiano, en = Inglese)
TTS_DEFAULT_LANG=it

# Configurazione Redis & Celery
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL_SECONDS=300
REDIS_HEALTH_TTL_SECONDS=10
REDIS_MODELS_TTL_SECONDS=300
CONVERSATION_MEMORY_MAX_MESSAGES=8

# Configurazione PostgreSQL Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hatsune_assistant

# Impostazioni specifiche per Piper
# Se lasciati vuoti, verranno scaricati automaticamente i modelli di default
PIPER_MODEL_PATH=
PIPER_CONFIG_PATH=
# Directory per salvare i file audio WAV generati
AUDIO_OUTPUT_DIR=app/static/generated_audio


# Impostazioni di Hardening & Timeout
REQUEST_TIMEOUT_SECONDS=60.0
STREAM_TIMEOUT_SECONDS=90.0

# Rate Limiting (es: 100/minute, 10/hour, 5/minute)
RATE_LIMIT_GLOBAL=100/minute
RATE_LIMIT_CHAT=15/minute
RATE_LIMIT_TTS=5/minute
RATE_LIMIT_HEALTH=120/minute

# Validazione Input
MAX_INPUT_CHARS=2000
MAX_CONTEXT_MESSAGES=20

# Sicurezza CORS (separati da virgola, es: http://localhost:3000,http://127.0.0.1:8000 o * per sviluppo)
CORS_ORIGINS=*

# Configurazione STT Whisper locale
# Modello Whisper da utilizzare (tiny, base, small, medium, large-v3)
STT_MODEL_SIZE=base
# Dispositivo per computazione (cpu, cuda, auto)
STT_DEVICE=auto
# Tipo di quantizzazione (int8, float16, float32)
STT_COMPUTE_TYPE=int8
# Lingua predefinita (it = Italiano, auto = automatico)
STT_DEFAULT_LANGUAGE=it
# Dimensione del beam per accuratezza (es: 5)
STT_BEAM_SIZE=5
# Percorso locale del modello (se già scaricato)
STT_MODEL_PATH=
