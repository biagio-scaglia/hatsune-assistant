# URL base dell'host Ollama locale
OLLAMA_BASE_URL=http://localhost:11434

# Modello predefinito da utilizzare
DEFAULT_MODEL=llama3:latest

# Ambiente dell'applicazione (development, production)
APP_ENV=development

# Configurazione TTS locale
# Provider disponibili: piper (attivo), cloud (predisposto)
TTS_PROVIDER=piper
# Voce predefinita (es: it_IT-riccardo-x_low, en_US-lessac-medium)
TTS_DEFAULT_VOICE=it_IT-riccardo-x_low
# Velocità predefinita (1.0 = normale)
TTS_DEFAULT_SPEED=1.0
# Lingua predefinita (it = Italiano, en = Inglese)
TTS_DEFAULT_LANG=it

# Impostazioni specifiche per Piper
# Se lasciati vuoti, verranno scaricati automaticamente i modelli di default
PIPER_MODEL_PATH=
PIPER_CONFIG_PATH=
# Directory per salvare i file audio WAV generati
AUDIO_OUTPUT_DIR=app/static/generated_audio


# Impostazioni di Hardening & Timeout
REQUEST_TIMEOUT_SECONDS=60.0
STREAM_TIMEOUT_SECONDS=90.0

# Rate Limiting (es: 100/minute, 10/hour, 5/minute)
RATE_LIMIT_GLOBAL=100/minute
RATE_LIMIT_CHAT=15/minute
RATE_LIMIT_TTS=5/minute
RATE_LIMIT_HEALTH=120/minute

# Validazione Input
MAX_INPUT_CHARS=2000
MAX_CONTEXT_MESSAGES=20

# Sicurezza CORS (separati da virgola, es: http://localhost:3000,http://127.0.0.1:8000 o * per sviluppo)
CORS_ORIGINS=*
